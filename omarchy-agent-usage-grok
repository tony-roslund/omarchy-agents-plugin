def proxy_base() -> str:
  return (os.environ.get("GROK_CLI_CHAT_PROXY_BASE_URL") or DEFAULT_PROXY).rstrip("/")


def access_token(home: Path) -> tuple[str, str]:
  data = read_json(home / "auth.json") or {}
  best = ""
  best_exp = ""
  for value in data.values():
    if not isinstance(value, dict):
      continue
    token = str(value.get("key") or value.get("access_token") or "")
    if not token:
      continue
    exp = str(value.get("expires_at") or "")
    if not best or exp > best_exp:
      best, best_exp = token, exp
  return best, best_exp


def token_expired(expires_at: str) -> bool:
  raw = str(expires_at or "").strip()
  if not raw:
    return False
  try:
    parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return False
  if parsed.tzinfo is None:
    parsed = parsed.replace(tzinfo=timezone.utc)
  return parsed <= datetime.now(timezone.utc)


def money(value: Any) -> float:
  if isinstance(value, dict):
    value = value.get("val", value.get("value", 0))
  try:
    amount = float(value or 0)
  except (TypeError, ValueError):
    return 0.0
  if amount != amount:
    return 0.0
  return max(0.0, amount)


def usage_percent(value: Any) -> float:
  try:
    n = float(value)
  except (TypeError, ValueError):
    return -1.0
  if n != n or n < 0:
    return -1.0
  return min(1.0, n / 100.0)


def period_label(period_type: str) -> str:
  text = str(period_type or "").upper()
  if "MONTH" in text:
    return "Monthly"
  if "DAY" in text and "WEEK" not in text:
    return "Daily"
  return "Weekly"


def display_label(value: Any) -> str:
  if not isinstance(value, str):
    return ""
  text = " ".join(value.split())
  if not text or any(ord(ch) < 32 for ch in text) or len(text) > 128:
    return ""
  return text


def product_label(product: str) -> str:
  raw = str(product or "").strip()
  if raw.lower() in ("grokbuild", "grok_build", "grok-build"):
    return "Grok Build"
  if raw.lower() in ("grokchat", "grok_chat", "grok-chat"):
    return "Grok Chat"
  return display_label(raw)


def fetch_json(url: str, token: str) -> dict[str, Any]:
  request = urllib.request.Request(
    url,
    headers={
      "Authorization": "Bearer " + token,
      "Accept": "application/json",
      "x-grok-client-mode": "cli",
    },
  )
  with urllib.request.urlopen(request, timeout=10) as response:
    payload = json.loads(response.read().decode("utf-8", errors="replace"))
  return payload if isinstance(payload, dict) else {}


def parse_billing(payload: dict[str, Any], plan: str) -> dict[str, Any]:
  result: dict[str, Any] = {
    "limits": [],
    "tierLabel": plan,
    "usageStatusText": "",
    "authHelpText": "",
    "balance": None,
  }
  config = payload.get("config") if isinstance(payload.get("config"), dict) else payload
  if not isinstance(config, dict):
    config = {}

  period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
  reset = str((period or {}).get("end") or config.get("billingPeriodEnd") or "")
  window = period_label(str((period or {}).get("type") or ""))

  percent = usage_percent(config.get("creditUsagePercent"))
  if percent >= 0:
    result["limits"].append({
      "label": window,
      "title": window,
      "percent": percent,
      "resetsAt": reset,
    })

  seen = {window}
  products = config.get("productUsage")
  if isinstance(products, list):
    for entry in products:
      if not isinstance(entry, dict):
        continue
      product = str(entry.get("product") or "")
      # Voice is a different SuperGrok product; this panel is the coding agent.
      if product.lower() in ("grokvoice", "grok_voice", "grok-voice"):
        continue
      label = product_label(product)
      if not label or label in seen:
        continue
      product_percent = usage_percent(entry.get("usagePercent", entry.get("percent")))
      if product_percent < 0:
        continue
      seen.add(label)
      title = f"{label} {window}".strip()
      result["limits"].append({
        "label": title,
        "title": title,
        "percent": product_percent,
        "resetsAt": reset,
      })

  prepaid = money(config.get("prepaidBalance"))
  cap = money(config.get("onDemandCap"))
  spent = money(config.get("onDemandUsed"))
  remaining = prepaid + max(0.0, cap - spent)
  funded = prepaid + cap
  # A SuperGrok weekly pool with a zero prepaid ledger is a limit meter, not
  # a $0.00 remaining fuel gauge.
  if remaining > 0 or funded > 0:
    result["balance"] = {
      "remaining": remaining,
      "funded": funded,
      "spent": spent,
      "currency": "USD",
    }

  if not result["tierLabel"]:
    result["tierLabel"] = display_label(
      payload.get("subscription_tier_display")
      or config.get("subscription_tier_display")
      or payload.get("subscriptionTier")
      or config.get("subscriptionTier")
    )
  return result


def collect_limits(home: Path, force: bool) -> dict[str, Any]:
  result: dict[str, Any] = {
    "limits": [],
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
    "balance": None,
  }
  token, expires_at = access_token(home)
  probe_cache = cache_root() / "grok-limits.json"
  cached = read_fresh_json(probe_cache, float("inf")) or {}
  fallback_limits = cached.get("limits") if isinstance(cached.get("limits"), list) else []
  fallback_plan = display_label(cached.get("tierLabel"))
  fallback_balance = cached.get("balance") if isinstance(cached.get("balance"), dict) else None

  if token == "":
    result["limits"] = fallback_limits
    result["tierLabel"] = fallback_plan
    result["balance"] = fallback_balance
    result["usageStatusText"] = "Waiting for auth"
    return result
  if token_expired(expires_at):
    result["limits"] = fallback_limits
    result["tierLabel"] = fallback_plan
    result["balance"] = fallback_balance
    result["usageStatusText"] = "Sign-in expired"
    result["authHelpText"] = (
      "Grok's saved sign-in expired"
      + (" — showing the last known limits." if fallback_limits else ".")
      + " Run `grok login` to refresh it."
    )
    return result

  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  if fallback_limits and not force and fetched_at and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    result["limits"] = fallback_limits
    result["tierLabel"] = fallback_plan
    result["balance"] = fallback_balance
    result["authHelpText"] = ""
    return result

  base = proxy_base()
  try:
    billing = fetch_json(base + "/billing?format=credits", token)
    plan = ""
    try:
      settings = fetch_json(base + "/settings", token)
      plan = display_label(settings.get("subscription_tier_display"))
    except Exception:
      plan = ""
    parsed = parse_billing(billing, plan)
    if not parsed["limits"] and parsed.get("balance") is None:
      if fallback_limits:
        result["limits"] = fallback_limits
        result["tierLabel"] = fallback_plan or parsed["tierLabel"]
        result["balance"] = fallback_balance
        result["authHelpText"] = ""
        return result
      result["usageStatusText"] = "Grok limits unavailable"
      result["authHelpText"] = "Grok's billing endpoint returned no limits. Local Grok stats are still shown."
      return result
    result.update(parsed)
    result["authHelpText"] = ""
    write_json(probe_cache, {
      "fetchedAtMs": round(time.time() * 1000),
      "limits": parsed["limits"],
      "tierLabel": parsed["tierLabel"],
      "balance": parsed.get("balance"),
    })
    return result
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      result["limits"] = fallback_limits
      result["tierLabel"] = fallback_plan
      result["balance"] = fallback_balance
      result["usageStatusText"] = "Sign-in expired"
      result["authHelpText"] = AUTH_HELP
      return result
    if fallback_limits:
      result["limits"] = fallback_limits
      result["tierLabel"] = fallback_plan
      result["balance"] = fallback_balance
      result["authHelpText"] = ""
      return result
    result["usageStatusText"] = "Grok limits unavailable"
    result["authHelpText"] = f"Grok's billing endpoint returned status {error.code}. Local Grok stats are still shown."
    return result
  except Exception:
    result["retryAdvised"] = True
    if fallback_limits:
      result["limits"] = fallback_limits
      result["tierLabel"] = fallback_plan
      result["balance"] = fallback_balance
      result["authHelpText"] = ""
      return result
    result["usageStatusText"] = "Grok limits unavailable"
    result["authHelpText"] = "Couldn't reach Grok's billing endpoint. Retrying shortly. Local Grok stats are still shown."
    return result


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan sessions and re-probe limits, ignoring caches")
  parser.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the limits probe must be fresh")
  parser.add_argument("--cache-seconds", type=float, default=SCAN_REUSE_SECONDS)
  args = parser.parse_args()

  home = grok_home()
  scan_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else args.cache_seconds)
  try:
    stats = cached_scan(home / "sessions", scan_age)
  except Exception as exc:
    print(f"omarchy-agent-usage-grok: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    stats = scan_sessions(home / "sessions")

  has_data = number(stats.get("totalPrompts")) > 0 or number(stats.get("totalSessions")) > 0
  limits = collect_limits(home, args.force)
  has_limits = len(limits["limits"]) > 0 or limits.get("balance") is not None

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": has_data or signed_in(home) or has_limits,
    "hasLocalStats": True,
    "hasPromptStats": True,
    "tierLabel": limits["tierLabel"],
    "usageStatusText": limits["usageStatusText"],
    "authHelpText": limits["authHelpText"],
    "limits": limits["limits"],
  }
  if limits.get("retryAdvised"):
    record["retryAdvised"] = True
  if limits.get("balance") is not None:
    record["balance"] = limits["balance"]
  record.update(stats)
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
